@unpublished{heimrath2026poisson,
  title    = {Poisson Statistics for Values of Binary Quadratic Forms in Short Intervals},
  author   = {Heimrath, Jack},
  year     = {2026},
  note     = {Preprint},
  abbr     = {Preprint},
  abstract = {We study the number of integers represented by a binary quadratic form in short intervals. Extending the work of Freiberg, Kurlberg, and Rosenzweig on sums of two squares, we formulate an analogue of the Hardy--Littlewood prime k-tuple conjecture for the integers represented by a genus of primitive positive definite binary quadratic forms of a fixed negative discriminant. We show that this hypothesis implies that the number of integers represented by a genus, and by each class in the genus, in a random interval (n, n + y] with n <= x, where y is tau times the average spacing sqrt(log x)/b(d), is asymptotically Poisson distributed with parameter tau. The proof uses the method of moments, with Bernays' asymptotic for the number of represented integers in place of the prime number theorem, and an adaptation of Ford's simplified argument for the average of the singular series. We also give numerical evidence for the hypothesis.},
  pdf      = {poisson-binary-quadratic-forms.pdf},
  selected = {true}
}
